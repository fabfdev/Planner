<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Title" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="Theme.Planner.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Planner.BottomSheet</item>
    </style>

    <style name="Widget.Planner.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Planner.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Planner.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/md_16dp</item>
        <item name="cornerSizeTopRight">@dimen/md_16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.Planner.DatePickerDialog" parent="@android:style/Theme.Material.Dialog">
        <item name="android:colorAccent">@color/lime_300</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/zinc_400</item>
        <item name="android:colorBackground">@color/zinc_950</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Theme.Planner.DatePickerDialog.Button</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Theme.Planner.DatePickerDialog.Button</item>
    </style>

    <style name="Theme.Planner.DatePickerDialog.Button" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/lime_300</item>
    </style>

</resources>
